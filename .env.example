# Cited Docs QA
# Copy to .env.local. With none of the keys set, `pnpm dev` runs in demo mode:
# local JSON storage, hashed embeddings, and extractive answers. No API calls.

# ---- Models ----
# openai | anthropic | demo
# Default: openai when OPENAI_API_KEY is set, otherwise demo.
CHAT_PROVIDER=demo

# openai | demo
# Default: openai when a key is set and chat is not demo, otherwise demo.
EMBEDDING_PROVIDER=demo

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest

# Set to false to use vector search only. Default is hybrid (vector + keyword).
HYBRID_SEARCH=true

# ---- Storage ----
# supabase | memory
# Default: supabase when both Supabase vars are set, otherwise a JSON file in .data/.
STORAGE_DRIVER=memory

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Workspace seam for a later multi-tenant step. Must be a UUID.
WORKSPACE_ID=00000000-0000-4000-8000-000000000001
WORKSPACE_NAME=Local workspace
OWNER_ID=local-owner
