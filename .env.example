# Cited Docs QA
# Copy to .env.local. With the keys left empty, `pnpm dev` stays in demo mode:
# local JSON storage, hashed embeddings, and extractive answers. No API calls.
# The banner explains each missing key.

# ---- Recommended real mode (sign-up works from mainland China) ----
# Chat: DeepSeek. https://platform.deepseek.com → API keys.
# Embeddings: SiliconFlow (硅基流动) BAAI/bge-m3.
#   https://cloud.siliconflow.cn → API keys. Free models may require real-name verification.
# Leave both keys blank to keep demo mode.

CHAT_PROVIDER=deepseek
EMBEDDING_PROVIDER=siliconflow

DEEPSEEK_API_KEY=
# Live ids: deepseek-flash (default) and deepseek-v4-pro (higher quality).
DEEPSEEK_CHAT_MODEL=deepseek-flash
# Optional. Default https://api.deepseek.com
# One SiliconFlow key can cover chat too. Point the DeepSeek client at
# SiliconFlow's OpenAI-compatible endpoint and use their model id:
#   DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
#   DEEPSEEK_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
#   DEEPSEEK_API_KEY=   (same value as SILICONFLOW_API_KEY)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

SILICONFLOW_API_KEY=
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# Optional. Default https://api.siliconflow.cn/v1
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---- Alternatives ----
# Switching to OpenAI is one change Upwork clients often expect:
#   CHAT_PROVIDER=openai
#   EMBEDDING_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
# Embeddings are requested at 1024 dimensions so they fit the same column.
# That is still a different vector space from bge-m3. Re-upload after switching.
# Anthropic can answer while another provider embeds:
#   CHAT_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest

# Set to false to use vector search only. Default is hybrid (vector + keyword).
HYBRID_SEARCH=true

# ---- Storage ----
# supabase | memory
# Default: supabase when both Supabase vars are set, otherwise a JSON file in .data/.
STORAGE_DRIVER=memory

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Workspace seam for a later multi-tenant step. Must be a UUID.
WORKSPACE_ID=00000000-0000-4000-8000-000000000001
WORKSPACE_NAME=Local workspace
OWNER_ID=local-owner
