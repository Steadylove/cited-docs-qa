{
  "name": "cited-docs-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Document Q&A with numbered citations, source highlights, and per-question cost tracking.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver"],
    "publicHoistPattern": ["*eslint*"]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "generate:fixture": "tsx scripts/generate-fixture.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "next": "^15.5.4",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.8",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
